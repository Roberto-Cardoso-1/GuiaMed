# ============================================================================
# GUIAMED BACKEND - Variáveis de Ambiente (.env.example)
# Copie para .env e preencha com seus valores reais
# ============================================================================

# Banco de Dados PostgreSQL
DATABASE_URL=postgresql://app_api:senha_forte_aqui@localhost:5432/guiamed
# Ou para Docker/Produção:
# DATABASE_URL=postgresql://app_api:senha_forte@db:5432/guiamed

# Chave de criptografia pgcrypto (mínimo 32 caracteres / 256 bits)
# USE UMA CHAVE FORTE E ÚNICA EM PRODUÇÃO!
PGCRYPTO_KEY=sua_chave_secreta_super_forte_aqui_256_bits_minimo_32_chars

# Configurações da API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Logging
LOG_LEVEL=INFO

# CORS (origens permitidas para o app mobile)
CORS_ORIGINS=["*"]

# Timezone
TZ=America/Sao_Paulo