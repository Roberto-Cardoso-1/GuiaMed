# ============================================================================
# GUIAMED BACKEND - Variáveis de Ambiente (.env.example)
# Copie para .env e preencha com seus valores reais
# ============================================================================

# Banco de Dados PostgreSQL (opcional em desenvolvimento; sem esta variável,
# as alergias ficam em memória até o backend ser reiniciado)
DATABASE_URL=postgresql://app_api:senha_forte_aqui@localhost:5432/guiamed
# Ou para Docker/Produção:
# DATABASE_URL=postgresql://app_api:senha_forte@db:5432/guiamed

# Configurações da API
API_HOST=0.0.0.0
API_PORT=8000
# Logging
LOG_LEVEL=INFO

# CORS é desnecessário para o app Android. Liste origens web explícitas se houver.
CORS_ORIGINS=[]

# Timezone
TZ=America/Sao_Paulo
