.env
*.env
!.env.example
appsettings*.json
secrets.*
*.pem
*.key

# Gradle
.gradle/
build/
*/build/
!**/src/main/**/build/
!**/src/test/**/build/

# Local configuration
local.properties

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Keystores
*.jks
*.keystore

# Legacy Tesseract data (ML Kit is used by V1)
app/src/main/assets/tessdata/*.traineddata

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Local or sensitive artifacts
auditoria/
backups/
